<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/title_area"
        android:layout_width="124dp"
        android:layout_height="match_parent"
        android:background="@drawable/date_panel_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:singleLine="true"
            android:textColor="@color/panel_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="d"
            android:format24Hour="d"
            android:includeFontPadding="false"
            android:textColor="@color/panel_text"
            android:textSize="48sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="MMMM yyyy"
            android:format24Hour="MMMM yyyy"
            android:singleLine="true"
            android:textColor="@color/panel_text_secondary"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/panel_text_secondary"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/refresh_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/refresh_bg_on_panel"
            android:contentDescription="@string/refresh"
            android:padding="8dp"
            android:src="@drawable/ic_refresh_white" />
    </LinearLayout>


    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/event_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/no_events"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
